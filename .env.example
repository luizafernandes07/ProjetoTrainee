# API
PORT=3002
NODE_ENV=production
FRONTEND_URL=http://localhost:5174
FRONTEND_ORIGIN=http://localhost:5174

# PostgreSQL
# Docker: DB_HOST=db e DB_PORT=5432
# Desenvolvimento fora do Docker: DB_HOST=localhost e DB_PORT=5433
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=ALTERE_PARA_UMA_SENHA_FORTE
DB_NAME=agnus_gestao

# JWT: gere uma chave aleatória forte (mínimo de 32 caracteres)
JWT_SECRET=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_LONGA_DE_PELO_MENOS_32_CARACTERES
JWT_EXPIRES_IN=1d

# Administrador inicial
ADMIN_EMAIL=admin@agnus.com
ADMIN_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE
ADMIN_NAME=Administrador

# SMTP para recuperação de senha
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=seuemail@gmail.com
MAIL_PASS=SENHA_DE_APP_GMAIL
