            "description": "Copie o token da resposta para a variável token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"senha\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  const perfil = String(body.usuario?.perfil || '').toLowerCase();",
                  "  pm.collectionVariables.set('token', body.token);",
                  "  if (perfil) pm.collectionVariables.set('token_' + perfil, body.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login CLIENTE",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
